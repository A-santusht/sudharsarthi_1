{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "sudharsarthi/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/sudharsarthi/frontend/assets/$1"
    },
    {
      "src": "/",
      "dest": "/sudharsarthi/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/sudharsarthi/frontend/$1"
    }
  ]
}
