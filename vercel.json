{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sudharsarthi.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://sudharsarthi.onrender.com/uploads/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/sudharsarthi/frontend/assets/:path*"
    },
    {
      "source": "/",
      "destination": "/sudharsarthi/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/sudharsarthi/frontend/$1"
    }
  ]
}
