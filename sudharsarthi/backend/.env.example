# Copy to .env and fill in (or export these in your shell). Everything is optional:
# with nothing set the backend still runs - rules-engine urgency + emails saved to ./outbox/.

# --- AI photo check (Claude vision). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Real emails to ward officers (otherwise they are written to ./outbox/)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM=your.address@gmail.com
# used when a ward is not listed in wards.json
DEFAULT_OFFICER_EMAIL=awasthishailendra59@gmail.com
# Automatic recipient for every lodged report
ALERT_RECIPIENT_EMAIL=awasthishailendra59@gmail.com

# --- Server
PORT=5000
# Serve the static front end from the same server (path to your SUDHARSARTHI folder):
FRONTEND_DIR=
CORS_ORIGIN=*
